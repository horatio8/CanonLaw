# -----------------------------------------------------------------------------
# Canon Law Tribunal — environment
#
# For Vercel, set these in Project Settings → Environment Variables.
# For local dev, copy this file to .env.local and fill in.
# -----------------------------------------------------------------------------

# ---- Supabase ----
# From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Keep secret. Never expose to the browser or commit to git.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App base URL ----
# Used to build OAuth redirect URIs and magic-link return URLs.
# Set to your Vercel production domain, e.g. https://canonlaw.example.com
# For local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Airtable OAuth integration ----
# Register at https://airtable.com/create/oauth and copy the Client ID.
# Scopes to request on the integration:
#   data.records:read data.records:write schema.bases:read schema.bases:write
# Redirect URI on the integration MUST be:
#   <NEXT_PUBLIC_APP_URL>/api/airtable/callback
AIRTABLE_CLIENT_ID=
# Only set for "confidential" OAuth integrations (optional).
AIRTABLE_CLIENT_SECRET=

# ---- Vercel Cron (optional) ----
# If set, the /api/cron/* routes require Bearer auth. Vercel Cron sends this
# automatically when the env var is present.
VERCEL_CRON_SECRET=

# ---- Demo banner ----
# Set to "false" to hide the demo-credentials hint on the login page.
SHOW_DEMO_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Legacy (local CLI admin only, not used in Vercel deployment)
# -----------------------------------------------------------------------------
# CANONLAW_MASTER_KEY=
# CANONLAW_SESSION_KEY=
# AIRTABLE_REDIRECT_URI=http://localhost:3000/auth/callback
