# -----------------------------------------------------------------------------
# Canon Law Tribunal — super-admin environment
#
# Copy this file to `.env` and fill in the values. Never commit .env to git.
# -----------------------------------------------------------------------------

# Airtable OAuth integration (create at https://airtable.com/create/oauth).
# Scopes to request: data.records:read data.records:write schema.bases:read schema.bases:write
AIRTABLE_CLIENT_ID=
# Optional — set if your OAuth integration is configured as a confidential client.
AIRTABLE_CLIENT_SECRET=
# Must match the redirect URI registered on your integration. Default below.
AIRTABLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Key used to encrypt OAuth tokens on disk (AES-256-GCM). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED when NODE_ENV=production.
CANONLAW_MASTER_KEY=

# Session-cookie signing key. Generate the same way as above. Optional in dev.
CANONLAW_SESSION_KEY=

# Where to store encrypted config. Default: ~/.canonlaw-tribunal
# CANONLAW_CONFIG_DIR=

# Admin server port. Default: 3000
# PORT=3000
